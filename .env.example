NEXT_PUBLIC_SITE_URL=https://www.100cuci.ad

# WordPress REST base（和 96m 一样，不要末尾斜杠）
# 例：https://cms.100cuci.ad/wp-json
WP_REST_URL=https://cms.100cuci.ad/wp-json

# 兼容：若只填站点根地址，sync 脚本会自动拼 /wp-json
# WORDPRESS_URL=https://cms.100cuci.ad

# GitHub OAuth — 旧 /admin（Decap）登录用（可选）
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional — Google Search Console
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
